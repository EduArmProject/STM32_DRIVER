# ============================================================
# .gitignore — STM32CubeIDE / STM32CubeMX project
# ============================================================

# ---------- Build output ----------
Debug/
Release/
build/
*.o
*.d
*.elf
*.bin
*.hex
*.map
*.list
*.srec

# ---------- IDE settings (Eclipse / STM32CubeIDE) ----------
.settings/
.cproject
.project
.mxproject

# ---------- HAL / CMSIS Drivers (re-generated by CubeMX) ----------
# These are large vendor libraries, everyone can regenerate them
# from the .ioc file via STM32CubeMX → "Generate Code".
Drivers/

# ---------- OS / editor junk ----------
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
.vscode/
.idea/

# ---------- Temporary / backup files ----------
*.bak
*.tmp
